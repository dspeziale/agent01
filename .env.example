# Configurazione Sysmon Agent via Variabili d'Ambiente
SYSMON_SERVER_URL=https://127.0.0.1:8443/api/v1/metrics
SYSMON_API_KEY=segreto123
SYSMON_AUTH_TYPE=Bearer
SYSMON_AUTH_HEADER=Authorization
SYSMON_INTERVAL=10
SYSMON_TIMEOUT=10
SYSMON_VERIFY_SSL=true
SYSMON_MAX_RETRIES=3
SYSMON_OFFLINE_BUFFER=true
SYSMON_BUFFER_DB=sysmon_buffer.db
SYSMON_TOP_PROCESSES=5
SYSMON_LOG_LEVEL=INFO
SYSMON_LOG_FILE=sysmon.log
